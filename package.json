{
  "name": "hashland-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf-typegen": "pnpm -F hashland cf-typegen",
    "dev": "pnpm -F hashland dev",
    "build": "pnpm -F hashland build",
    "start": "pnpm -F hashland start",
    "deploy": "pnpm -F hashland run deploy",
    "fmt": "oxfmt",
    "lint": "oxlint --type-aware"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "oxlint-tsgolint": "^0.15.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "overrides": {
      "safe-buffer": "npm:@nolyfill/safe-buffer@^1",
      "safer-buffer": "npm:@nolyfill/safer-buffer@^1",
      "vite": "8.0.0-beta.18",
      "lightningcss": "1.32.0",
      "@vitejs/plugin-react": "6.0.0-beta.0",
      "@rolldown/pluginutils": "1.0.0-rc.8"
    }
  }
}
